  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "private": true
}
